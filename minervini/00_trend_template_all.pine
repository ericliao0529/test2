//@version=6
// =============================================================================
//  Minervini 超級績效趨勢樣板 (統整版 / 8 指標計分)
//  參考：Mark Minervini《超級績效 Trade Like a Stock Market Wizard》
//  把 8 大條件逐一計算後加總，右上角顯示符合幾項 (0~8)。
//  建議使用日線。
// =============================================================================
indicator("Minervini 趨勢樣板 (統整 8 指標)", overlay=true)

// ---------- 參數 ----------
benchmark   = input.symbol("SPX", "RS 比較標的 (台股可改 TWSE:TAIEX)")
rsThreshold = input.int(70, "RS 評級門檻", minval=0, maxval=100)
trendDays   = input.int(22, "200MA 上升趨勢觀察天數")
showTable   = input.bool(true, "顯示計分表")

// ---------- 基礎資料 ----------
ma50   = ta.sma(close, 50)
ma150  = ta.sma(close, 150)
ma200  = ta.sma(close, 200)
low52  = ta.lowest(low, 252)
high52 = ta.highest(high, 252)

// ---------- 8 個指標 ----------
cond1 = (close > ma150) and (close > ma200)          // 1 價站上 150/200MA
cond2 = ma150 > ma200                                 // 2 150MA > 200MA
cond3 = ma200 > ma200[trendDays]                      // 3 200MA 上升中
cond4 = (ma50 > ma150) and (ma50 > ma200)             // 4 50MA > 150/200MA
cond5 = close > ma50                                  // 5 價 > 50MA
cond6 = close >= low52 * 1.30                         // 6 高於52週低點 30%
cond7 = close >= high52 * 0.75                        // 7 距52週高點 25%內

// 8 RS 相對強度評級
benchClose = request.security(benchmark, timeframe.period, close)
stockPerf  = close / close[252] - 1
benchPerf  = benchClose / benchClose[252] - 1
rsRatio    = (1 + stockPerf) / (1 + benchPerf)
rsRank     = ta.percentrank(rsRatio, 252)
cond8      = rsRank >= rsThreshold

// ---------- 計分 ----------
score = (cond1 ? 1 : 0) + (cond2 ? 1 : 0) + (cond3 ? 1 : 0) + (cond4 ? 1 : 0) + (cond5 ? 1 : 0) + (cond6 ? 1 : 0) + (cond7 ? 1 : 0) + (cond8 ? 1 : 0)
passAll = score == 8

// ---------- 繪圖 (均線會跟著圖表移動) ----------
plot(ma50,  "MA50",  color=color.aqua)
plot(ma150, "MA150", color=color.orange)
plot(ma200, "MA200", color=color.red, linewidth=2)
// 三角形只標『首次轉成 8/8 的那一根』(進場轉折點)；背景綠色標示整段符合期間
firstPass = passAll and not passAll[1]
plotshape(firstPass, "首次8項全符合", shape.triangleup, location.belowbar, color.lime, size=size.small)
bgcolor(passAll ? color.new(color.green, 88) : na)

// ---------- 解法A：輸出到 Data Window (數據視窗)----------
// 把游標移到任一根歷史 K 棒，右側「數據視窗」即顯示『那一根』的分數與各條件 (1=符合,0=不符合)
plot(score,            "總分 (0~8)", display=display.data_window)
plot(cond1 ? 1 : 0, "1 價>150/200MA", display=display.data_window)
plot(cond2 ? 1 : 0, "2 150>200MA",    display=display.data_window)
plot(cond3 ? 1 : 0, "3 200MA上升",    display=display.data_window)
plot(cond4 ? 1 : 0, "4 50>150/200MA", display=display.data_window)
plot(cond5 ? 1 : 0, "5 價>50MA",      display=display.data_window)
plot(cond6 ? 1 : 0, "6 高於52週低30%",display=display.data_window)
plot(cond7 ? 1 : 0, "7 距52週高25%內",display=display.data_window)
plot(cond8 ? 1 : 0, "8 RS評級達標",   display=display.data_window)
plot(rsRank,          "RS評級",       display=display.data_window)

// ---------- 計分表 ----------
f_mark(c) => c ? "✅" : "❌"

if showTable
    var table t = table.new(position.top_right, 2, 10, border_width=1, frame_width=1, frame_color=color.gray)
    table.cell(t, 0, 0, "Minervini 趨勢樣板", text_color=color.black, bgcolor=color.new(color.blue, 80), text_halign=text.align_left)
    table.cell(t, 1, 0, str.tostring(score) + " / 8", text_color=color.black, bgcolor=passAll ? color.new(color.green,60) : color.new(color.blue,80), text_halign=text.align_left)
    table.cell(t, 0, 1, "1. 價>150MA 且 >200MA", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 1, f_mark(cond1), text_halign=text.align_left)
    table.cell(t, 0, 2, "2. 150MA > 200MA", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 2, f_mark(cond2), text_halign=text.align_left)
    table.cell(t, 0, 3, "3. 200MA 上升中", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 3, f_mark(cond3), text_halign=text.align_left)
    table.cell(t, 0, 4, "4. 50MA > 150MA,200MA", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 4, f_mark(cond4), text_halign=text.align_left)
    table.cell(t, 0, 5, "5. 價 > 50MA", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 5, f_mark(cond5), text_halign=text.align_left)
    table.cell(t, 0, 6, "6. 高於52週低點 30%+", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 6, f_mark(cond6), text_halign=text.align_left)
    table.cell(t, 0, 7, "7. 距52週高點 25%內", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 7, f_mark(cond7), text_halign=text.align_left)
    table.cell(t, 0, 8, "8. RS評級 >= " + str.tostring(rsThreshold), text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 8, f_mark(cond8), text_halign=text.align_left)
    table.cell(t, 0, 9, "RS 評級 (近一年百分位)", text_color=color.black, text_halign=text.align_left)
    table.cell(t, 1, 9, str.tostring(math.round(rsRank)), text_color=color.black, text_halign=text.align_left)

// ---------- 警報 ----------
alertcondition(passAll, "趨勢樣板 8 項全符合", "{{ticker}} 符合 Minervini 趨勢樣板全部 8 項!")
