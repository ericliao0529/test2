//@version=5
// =============================================================================
//  Minervini 超級績效趨勢樣板 (Trend Template)
//  作者參考：Mark Minervini《超級績效 Trade Like a Stock Market Wizard》
//  說明：判斷個股是否進入「第二階段上升趨勢」的 8 大條件，
//        逐一計算後加總，顯示符合幾項 (0~8)。
//  使用：貼到 TradingView 的 Pine 編輯器 → 新增至圖表 (建議用日線)。
// =============================================================================
indicator("Minervini 趨勢樣板 (8 指標)", overlay=true)

// -----------------------------------------------------------------------------
//  參數設定
// -----------------------------------------------------------------------------
src        = close
benchmark  = input.symbol("SPX",        "RS 相對強度比較標的 (大盤)")
rsThreshold= input.int(70,              "RS 評級門檻 (0~100)", minval=0, maxval=100)
trendDays  = input.int(22,              "200MA 上升趨勢觀察天數")
showTable  = input.bool(true,           "顯示計分表")

// -----------------------------------------------------------------------------
//  基礎資料：移動平均線 / 52 週高低點
// -----------------------------------------------------------------------------
ma50  = ta.sma(src, 50)
ma150 = ta.sma(src, 150)
ma200 = ta.sma(src, 200)

low52  = ta.lowest(low,  252)   // 52 週約 252 個交易日
high52 = ta.highest(high, 252)

// -----------------------------------------------------------------------------
//  指標 1：股價同時站上 150 日與 200 日均線
// -----------------------------------------------------------------------------
cond1 = (src > ma150) and (src > ma200)

// -----------------------------------------------------------------------------
//  指標 2：150 日均線 高於 200 日均線
// -----------------------------------------------------------------------------
cond2 = ma150 > ma200

// -----------------------------------------------------------------------------
//  指標 3：200 日均線 至少上升一個月 (預設 22 個交易日呈上升)
// -----------------------------------------------------------------------------
cond3 = ma200 > ma200[trendDays]

// -----------------------------------------------------------------------------
//  指標 4：50 日均線 高於 150 日與 200 日均線
// -----------------------------------------------------------------------------
cond4 = (ma50 > ma150) and (ma50 > ma200)

// -----------------------------------------------------------------------------
//  指標 5：股價 高於 50 日均線
// -----------------------------------------------------------------------------
cond5 = src > ma50

// -----------------------------------------------------------------------------
//  指標 6：股價 至少高於 52 週低點 30%
// -----------------------------------------------------------------------------
cond6 = src >= low52 * 1.30

// -----------------------------------------------------------------------------
//  指標 7：股價 距離 52 週高點 25% 以內 (即 >= 高點的 75%)
// -----------------------------------------------------------------------------
cond7 = src >= high52 * 0.75

// -----------------------------------------------------------------------------
//  指標 8：RS 相對強度評級 >= 門檻 (預設 70)
//          做法：以個股 vs 大盤的 12 個月報酬比值，計算近一年的百分位排名，
//          轉換成 0~100 的 RS 評級。
// -----------------------------------------------------------------------------
benchClose = request.security(benchmark, timeframe.period, close)

// 個股與大盤近一年 (252 日) 報酬
stockPerf = src / src[252] - 1
benchPerf = benchClose / benchClose[252] - 1

// 相對強度比值 (個股表現相對大盤)
rsRatio = (1 + stockPerf) / (1 + benchPerf)

// 將 rsRatio 在過去 252 日中做百分位排名 → 0~100 的 RS 評級
rsRank   = ta.percentrank(rsRatio, 252)
cond8    = rsRank >= rsThreshold

// -----------------------------------------------------------------------------
//  計分：加總符合的指標數
// -----------------------------------------------------------------------------
score = (cond1 ? 1 : 0) + (cond2 ? 1 : 0) + (cond3 ? 1 : 0) + (cond4 ? 1 : 0) +
        (cond5 ? 1 : 0) + (cond6 ? 1 : 0) + (cond7 ? 1 : 0) + (cond8 ? 1 : 0)

passAll = score == 8

// -----------------------------------------------------------------------------
//  繪圖：均線
// -----------------------------------------------------------------------------
plot(ma50,  "MA50",  color=color.new(color.aqua,  0), linewidth=1)
plot(ma150, "MA150", color=color.new(color.orange,0), linewidth=1)
plot(ma200, "MA200", color=color.new(color.red,   0), linewidth=2)

// 全數符合時於 K 棒下方標記
plotshape(passAll, title="8 項全符合", style=shape.triangleup,
          location=location.belowbar, color=color.lime, size=size.small)

bgcolor(passAll ? color.new(color.green, 88) : na)

// -----------------------------------------------------------------------------
//  計分表
// -----------------------------------------------------------------------------
f_mark(c) => c ? "✅" : "❌"

if showTable
    var table t = table.new(position.top_right, 2, 10,
                            border_width=1, frame_width=1, frame_color=color.gray)
    table.cell(t, 0, 0, "Minervini 趨勢樣板", text_color=color.white,
               bgcolor=color.new(color.blue, 0), text_size=size.normal)
    table.cell(t, 1, 0, str.tostring(score) + " / 8", text_color=color.white,
               bgcolor=passAll ? color.new(color.green,0) : color.new(color.blue,0),
               text_size=size.normal)

    table.cell(t, 0, 1, "1. 價>150MA 且 >200MA", text_color=color.white)
    table.cell(t, 1, 1, f_mark(cond1))
    table.cell(t, 0, 2, "2. 150MA > 200MA",      text_color=color.white)
    table.cell(t, 1, 2, f_mark(cond2))
    table.cell(t, 0, 3, "3. 200MA 上升中",        text_color=color.white)
    table.cell(t, 1, 3, f_mark(cond3))
    table.cell(t, 0, 4, "4. 50MA > 150MA,200MA", text_color=color.white)
    table.cell(t, 1, 4, f_mark(cond4))
    table.cell(t, 0, 5, "5. 價 > 50MA",           text_color=color.white)
    table.cell(t, 1, 5, f_mark(cond5))
    table.cell(t, 0, 6, "6. 高於52週低點 30%+",   text_color=color.white)
    table.cell(t, 1, 6, f_mark(cond6))
    table.cell(t, 0, 7, "7. 距52週高點 25%內",    text_color=color.white)
    table.cell(t, 1, 7, f_mark(cond7))
    table.cell(t, 0, 8, "8. RS評級 >= " + str.tostring(rsThreshold), text_color=color.white)
    table.cell(t, 1, 8, f_mark(cond8))
    table.cell(t, 0, 9, "RS 評級 (近一年百分位)", text_color=color.yellow)
    table.cell(t, 1, 9, str.tostring(math.round(rsRank)), text_color=color.yellow)

// -----------------------------------------------------------------------------
//  警報：8 項全部符合
// -----------------------------------------------------------------------------
alertcondition(passAll, title="趨勢樣板 8 項全符合",
               message="{{ticker}} 符合 Minervini 趨勢樣板全部 8 項條件!")
