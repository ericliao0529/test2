//@version=6
// 策略 03：量價突破（爆量過前高）
// 邏輯：成交量爆量（> N 日均量的倍數）且收盤突破近期高點時進場，
//       代表帶量突破整理區；出場用前低跌破或停利。
// 適用：日線，中小型成長股、題材股。
strategy("03 爆量突破前高", overlay = true,
     initial_capital = 50000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 95,
     commission_type = strategy.commission.percent, commission_value = 0,
     slippage = 0)

// ===== 參數 =====
hhLen     = input.int(50, "突破回看期（前高）", minval = 5)
llLen     = input.int(20, "出場回看期（前低）", minval = 5)
volMaLen  = input.int(20, "均量長度")
volMult   = input.float(2.0, "爆量倍數（量 > 均量 x N）", step = 0.25)
takeProfitPct = input.float(25.0, "停利 %", step = 1)
stopPct       = input.float(8.0,  "停損 %", step = 0.5)
useRVOL   = input.bool(true, "啟用相對成交量(RVOL)確認")

startDate = input.time(timestamp("2018-01-01"), "回測起始日")
endDate   = input.time(timestamp("2030-12-31"), "回測結束日")
inRange   = time >= startDate and time <= endDate

// ===== 指標 =====
highest50 = ta.highest(high, hhLen)[1]   // 不含當根的前高
lowest20  = ta.lowest(low, llLen)[1]
volMA     = ta.sma(volume, volMaLen)
rvol      = volume / volMA               // 相對成交量
volSpike  = not useRVOL or rvol > volMult

// 突破：收盤站上前高 + 爆量 + 紅K（收 > 開）
breakout = close > highest50 and volSpike and close > open

// ===== 進出場 =====
if inRange and breakout and strategy.position_size == 0
    strategy.entry("突破多", strategy.long)

if strategy.position_size > 0
    entryPrice = strategy.opentrades.entry_price(0)
    strategy.exit("停利停損", from_entry = "突破多",
         limit = entryPrice * (1 + takeProfitPct / 100),
         stop  = entryPrice * (1 - stopPct / 100))
    // 結構破壞：跌破近期低點
    if close < lowest20
        strategy.close("突破多", comment = "跌破前低")

// ===== 繪圖 =====
plot(highest50, "前高", color = color.green, style = plot.style_linebr)
plot(lowest20, "前低", color = color.red, style = plot.style_linebr)
plotchar(breakout, "爆量突破", "▲", location.belowbar, color.lime, size = size.small)
