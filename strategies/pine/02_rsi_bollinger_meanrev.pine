//@version=6
// 策略 02：RSI + 布林通道均值回歸
// 邏輯：價格跌破布林下軌且 RSI 超賣時逢低買進，回到中軌（均值）出場。
//       加入長期均線多頭濾網，避免在空頭趨勢中接刀。
// 適用：日線，震盪型或大型權值股。
strategy("02 RSI+布林 均值回歸", overlay = true,
     initial_capital = 1000000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 95,
     commission_type = strategy.commission.percent, commission_value = 0.1,
     slippage = 2)

// ===== 參數 =====
bbLen     = input.int(20, "布林通道長度")
bbMult    = input.float(2.0, "布林標準差倍數", step = 0.1)
rsiLen    = input.int(14, "RSI 長度")
rsiOS     = input.float(30, "RSI 超賣門檻")
rsiExitLv = input.float(55, "RSI 出場門檻")
trendLen  = input.int(200, "長期趨勢均線（多頭濾網）")
useTrendFilter = input.bool(true, "啟用多頭趨勢濾網")
stopPct   = input.float(7.0, "固定停損 %", step = 0.5)
maxHold   = input.int(15, "最長持有 K 棒數", minval = 1)

startDate = input.time(timestamp("2018-01-01"), "回測起始日")
endDate   = input.time(timestamp("2030-12-31"), "回測結束日")
inRange   = time >= startDate and time <= endDate

// ===== 指標 =====
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upperBB = basis + dev
lowerBB = basis - dev
rsi   = ta.rsi(close, rsiLen)
trendMA = ta.sma(close, trendLen)
bullMarket = not useTrendFilter or close > trendMA

// ===== 訊號 =====
longEntry = close < lowerBB and rsi < rsiOS and bullMarket
longExit  = close > basis or rsi > rsiExitLv

if inRange and longEntry and strategy.position_size == 0
    strategy.entry("低接", strategy.long)

if strategy.position_size > 0
    // 回到均值或 RSI 修復即出場
    if longExit
        strategy.close("低接", comment = "回均值")
    // 持有過久強制出場（均值回歸失效）
    if bar_index - strategy.opentrades.entry_bar_index(0) >= maxHold
        strategy.close("低接", comment = "逾時出場")
    // 固定百分比停損
    strategy.exit("停損", from_entry = "低接",
         stop = strategy.opentrades.entry_price(0) * (1 - stopPct / 100))

// ===== 繪圖 =====
plot(basis, "布林中軌", color = color.gray)
p1 = plot(upperBB, "上軌", color = color.new(color.teal, 50))
p2 = plot(lowerBB, "下軌", color = color.new(color.teal, 50))
fill(p1, p2, color = color.new(color.teal, 95))
plot(trendMA, "200MA 趨勢線", color = color.purple)
