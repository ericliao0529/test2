//@version=6
// 策略 04：OBV 籌碼累積 + 均線確認（量先價行）
// 邏輯：OBV（能量潮）上穿其均線代表買盤累積，若價格同時站上均線則進場；
//       OBV 與價格背離（OBV 走弱）時出場。捕捉「量先價行」的主力吸籌行情。
// 適用：日線／週線。
strategy("04 OBV 籌碼累積", overlay = false,
     initial_capital = 100,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 95,
     commission_type = strategy.commission.percent, commission_value = 0,
     slippage = 0)

// ===== 參數 =====
obvMaLen  = input.int(30, "OBV 均線長度")
priceMaLen = input.int(50, "價格均線長度")
mfiLen    = input.int(14, "MFI 長度（資金流確認）")
mfiThresh = input.float(50, "MFI 多方門檻")
stopPct   = input.float(10.0, "固定停損 %", step = 0.5)

startDate = input.time(timestamp("2018-01-01"), "回測起始日")
endDate   = input.time(timestamp("2030-12-31"), "回測結束日")
inRange   = time >= startDate and time <= endDate

// ===== 指標 =====
obv    = ta.obv
obvMA  = ta.sma(obv, obvMaLen)
priceMA = ta.sma(close, priceMaLen)
mfi    = ta.mfi(hlc3, mfiLen)

obvBull   = obv > obvMA          // 籌碼累積中
priceBull = close > priceMA      // 價格趨勢確認
moneyIn   = mfi > mfiThresh      // 資金流入

longEntry = ta.crossover(obv, obvMA) and priceBull and moneyIn
longExit  = ta.crossunder(obv, obvMA)   // 籌碼鬆動即離場

// ===== 進出場 =====
if inRange and longEntry and strategy.position_size == 0
    strategy.entry("吸籌多", strategy.long)

if strategy.position_size > 0
    if longExit
        strategy.close("吸籌多", comment = "OBV轉弱")
    strategy.exit("停損", from_entry = "吸籌多",
         stop = strategy.opentrades.entry_price(0) * (1 - stopPct / 100))

// ===== 繪圖（副圖）=====
plot(obv, "OBV", color = color.blue)
plot(obvMA, "OBV 均線", color = color.orange)
plot(mfi, "MFI", color = color.purple, display = display.data_window)
bgcolor(obvBull and priceBull ? color.new(color.green, 90) : na)
