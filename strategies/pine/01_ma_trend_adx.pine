//@version=6
// 策略 01：雙均線趨勢跟蹤 + ADX 趨勢強度濾網
// 邏輯：快線上穿慢線且 ADX 確認趨勢強度時做多；跌破慢線或 ATR 移動停損出場。
// 適用：日線／4H，趨勢明顯的個股或指數。
strategy("01 雙均線趨勢 + ADX 濾網", overlay = true,
     initial_capital = 50000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 95,
     commission_type = strategy.commission.percent, commission_value = 0,
     slippage = 0)

// ===== 參數 =====
fastLen   = input.int(20,  "快速均線長度", minval = 2)
slowLen   = input.int(60,  "慢速均線長度", minval = 5)
maType    = input.string("EMA", "均線類型", options = ["SMA", "EMA"])
adxLen    = input.int(14,  "ADX 長度")
adxThresh = input.float(20, "ADX 趨勢門檻", minval = 5, maxval = 50)
atrLen    = input.int(14,  "ATR 長度")
atrMult   = input.float(3.0, "ATR 停損倍數", step = 0.5)
useShort  = input.bool(false, "允許做空")

startDate = input.time(timestamp("2018-01-01"), "回測起始日")
endDate   = input.time(timestamp("2030-12-31"), "回測結束日")
inRange   = time >= startDate and time <= endDate

// ===== 指標 =====
ma(src, len) => maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)
fastMA = ma(close, fastLen)
slowMA = ma(close, slowLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)

trendUp   = fastMA > slowMA
strongTrend = adx > adxThresh

longEntry  = ta.crossover(fastMA, slowMA) and strongTrend
longExit   = ta.crossunder(close, slowMA)
shortEntry = ta.crossunder(fastMA, slowMA) and strongTrend
shortExit  = ta.crossover(close, slowMA)

// ===== 進出場 =====
if inRange
    if longEntry
        strategy.entry("多單", strategy.long)
    if longExit
        strategy.close("多單", comment = "跌破慢線")
    if useShort
        if shortEntry
            strategy.entry("空單", strategy.short)
        if shortExit
            strategy.close("空單", comment = "突破慢線")

// ATR 移動停損
var float trailStop = na
if strategy.position_size > 0
    stopCandidate = close - atr * atrMult
    trailStop := na(trailStop) ? stopCandidate : math.max(trailStop, stopCandidate)
    strategy.exit("ATR停損", from_entry = "多單", stop = trailStop)
else
    trailStop := na

// ===== 繪圖 =====
plot(fastMA, "快線", color = color.orange)
plot(slowMA, "慢線", color = color.blue)
plot(strategy.position_size > 0 ? trailStop : na, "移動停損", color = color.red, style = plot.style_linebr)
bgcolor(strongTrend ? color.new(color.green, 92) : na)
